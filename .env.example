# Offline mode: no API key or network access required.
LLM_PROVIDER=mock

# Set this when using OpenAI or Anthropic; leave unset to use each adapter's default.
MODEL_NAME=
LLM_TIMEOUT_SECONDS=30
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# This app intentionally ignores unrelated DATABASE_URL settings.
SUPPORTOPS_DATABASE_URL=sqlite:///./supportops.db
MAX_AGENT_STEPS=8
TOOL_RETRY_ATTEMPTS=3
RETRY_BASE_DELAY_SECONDS=0.05