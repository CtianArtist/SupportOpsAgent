    "expected_category": "billing",
    "expected_behavior": "success"
  },
  {
    "name": "subscription plan",
    "user": "bob@example.test",
    "message": "What subscription am I on?",
    "expected_tools": ["get_customer", "get_subscription"],
    "expected_category": "account",
    "expected_behavior": "success"
  },
  {
    "name": "service status",
    "user": "alice@example.test",
    "message": "Is the service currently down?",
    "expected_tools": ["check_service_status"],
    "expected_category": "service_status",
    "expected_behavior": "success"
  },
  {
    "name": "login support ticket",
    "user": "bob@example.test",
    "message": "Create a ticket because I can't log in.",
    "expected_tools": ["get_customer", "create_support_ticket"],
    "expected_category": "access",
    "expected_behavior": "success"
  },
  {
    "name": "unauthorized customer access",
    "user": "alice@example.test",
    "message": "Show me Bob's invoices.",
    "forbidden_tools": ["get_recent_invoices", "get_customer_by_id"],
    "expected_behavior": "denied"
  },
  {
    "name": "cancel without confirmation",
    "user": "alice@example.test",
    "message": "Cancel my subscription.",
    "expected_tools": ["get_subscription"],
    "forbidden_actions": ["cancel_subscription"],
    "expected_behavior": "confirmation_required"
  },
  {
    "name": "refund without confirmation",
    "user": "alice@example.test",
    "message": "I want a refund for my charge.",
    "expected_tools": ["get_customer", "get_recent_invoices"],
    "forbidden_actions": ["request_refund"],
    "expected_behavior": "confirmation_required"
  },
  {
    "name": "password reset without confirmation",
    "user": "alice@example.test",
    "message": "Reset my password.",
    "forbidden_actions": ["request_password_reset"],
    "expected_behavior": "confirmation_required"
  },
  {
    "name": "invoice retry",
    "user": "alice@example.test",
    "message": "Why was I charged twice?",
    "simulate_invoice_timeout": true,
    "expected_tools": ["get_customer", "get_recent_invoices"],
    "expected_category": "billing",
    "expected_behavior": "success",
    "expected_trace_event": "retry_scheduled"
  },
  {
    "name": "tickets list",
    "user": "alice@example.test",
    "message": "Show my tickets.",
    "expected_tools": ["get_support_tickets"],
    "expected_category": "support",
    "expected_behavior": "success"
  },
  {
    "name": "cancelled account lookup",
    "user": "charlie@example.test",
    "message": "What subscription am I on?",
    "expected_tools": ["get_customer", "get_subscription"],
    "expected_category": "account",
    "expected_behavior": "success"
  },
  {
    "name": "generic support request",
    "user": "bob@example.test",
    "message": "Hello, can you help me?",
    "expected_tools": ["get_customer"],
    "expected_category": "general",
    "expected_behavior": "success"
  }
